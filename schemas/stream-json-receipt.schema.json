{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rafcodephi:recipt:stream-json-receipt:v1",
  "title": "RAFCODE-Φ Freestanding Stream JSON Receipt V1",
  "type": "object",
  "required": [
    "schema",
    "evidence_class",
    "parser_scope",
    "target_isa",
    "buffer_bytes",
    "bytes",
    "fnv1a64_raw",
    "root_array",
    "top_level_objects",
    "field_counts",
    "role_value_counts",
    "structural_errors",
    "read_error",
    "structural_ok",
    "claim_allowed"
  ],
  "properties": {
    "schema": {"const": "rafcodephi.freestanding.stream-json-receipt.v1"},
    "evidence_class": {"enum": ["MEASURED_LOCAL"]},
    "parser_scope": {"const": "structural_scan_not_full_json_semantics"},
    "target_isa": {"type": "string", "minLength": 1},
    "buffer_bytes": {"type": "integer", "minimum": 1},
    "bytes": {"type": "integer", "minimum": 0},
    "fnv1a64_raw": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
    "root_array": {"type": "boolean"},
    "top_level_objects": {"type": "integer", "minimum": 0},
    "object_open": {"type": "integer", "minimum": 0},
    "object_close": {"type": "integer", "minimum": 0},
    "array_open": {"type": "integer", "minimum": 0},
    "array_close": {"type": "integer", "minimum": 0},
    "strings": {"type": "integer", "minimum": 0},
    "escapes": {"type": "integer", "minimum": 0},
    "max_depth": {"type": "integer", "minimum": 0},
    "field_counts": {"type": "object"},
    "role_value_counts": {"type": "object"},
    "structural_errors": {"type": "integer", "minimum": 0},
    "read_error": {"type": "boolean"},
    "structural_ok": {"type": "boolean"},
    "claim_allowed": {"const": false}
  },
  "additionalProperties": false
}

