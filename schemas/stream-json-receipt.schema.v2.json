{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rafcodephi:recipt:stream-json-receipt:v2",
  "title": "RAFCODE-Φ Freestanding Stream JSON Receipt V2",
  "type": "object",
  "required": [
    "schema",
    "evidence_class",
    "parser_scope",
    "target_isa",
    "buffer_bytes",
    "bytes",
    "fnv1a64_raw",
    "root_array",
    "top_level_objects",
    "object_open",
    "object_close",
    "array_open",
    "array_close",
    "strings",
    "escapes",
    "max_depth",
    "field_counts",
    "role_value_counts",
    "structural_errors",
    "read_error",
    "structural_ok",
    "json_syntax_errors",
    "json_syntax_ok",
    "claim_allowed"
  ],
  "properties": {
    "schema": {"const": "rafcodephi.freestanding.stream-json-receipt.v2"},
    "evidence_class": {"const": "MEASURED_LOCAL"},
    "parser_scope": {"const": "structural_scan_plus_json_grammar_no_utf8_semantic_schema"},
    "target_isa": {"enum": ["x86_64-linux", "aarch64-linux", "armv7-eabi-linux"]},
    "buffer_bytes": {"const": 65536},
    "bytes": {"type": "integer", "minimum": 0},
    "fnv1a64_raw": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
    "root_array": {"const": true},
    "top_level_objects": {"type": "integer", "minimum": 0},
    "object_open": {"type": "integer", "minimum": 0},
    "object_close": {"type": "integer", "minimum": 0},
    "array_open": {"type": "integer", "minimum": 1},
    "array_close": {"type": "integer", "minimum": 1},
    "strings": {"type": "integer", "minimum": 0},
    "escapes": {"type": "integer", "minimum": 0},
    "max_depth": {"type": "integer", "minimum": 1, "maximum": 512},
    "field_counts": {
      "type": "object",
      "required": ["id", "title", "create_time", "update_time", "mapping", "current_node", "conversation_id", "message", "author", "role", "content", "parts"],
      "properties": {
        "id": {"type": "integer", "minimum": 0},
        "title": {"type": "integer", "minimum": 0},
        "create_time": {"type": "integer", "minimum": 0},
        "update_time": {"type": "integer", "minimum": 0},
        "mapping": {"type": "integer", "minimum": 0},
        "current_node": {"type": "integer", "minimum": 0},
        "conversation_id": {"type": "integer", "minimum": 0},
        "message": {"type": "integer", "minimum": 0},
        "author": {"type": "integer", "minimum": 0},
        "role": {"type": "integer", "minimum": 0},
        "content": {"type": "integer", "minimum": 0},
        "parts": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "role_value_counts": {
      "type": "object",
      "required": ["user", "assistant", "system", "tool", "developer"],
      "properties": {
        "user": {"type": "integer", "minimum": 0},
        "assistant": {"type": "integer", "minimum": 0},
        "system": {"type": "integer", "minimum": 0},
        "tool": {"type": "integer", "minimum": 0},
        "developer": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "structural_errors": {"const": 0},
    "read_error": {"const": false},
    "structural_ok": {"const": true},
    "json_syntax_errors": {"const": 0},
    "json_syntax_ok": {"const": true},
    "claim_allowed": {"const": false}
  },
  "additionalProperties": false
}
